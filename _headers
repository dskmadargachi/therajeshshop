# Cloudflare Pages static-asset headers (applies to files served from the Pages asset store).
# Brotli/gzip: Cloudflare compresses text/html, css, js, json, svg automatically at the edge - do NOT set Content-Encoding
# yourself and do not add "no-transform" to Cache-Control.

# Page bundles are always linked as /name.ext?v=<content-hash>, so a new deploy = new URL -> safe to cache for a year.
/index.css
  Cache-Control: public, max-age=31536000, immutable
/index-2.css
  Cache-Control: public, max-age=31536000, immutable
/index.js
  Cache-Control: public, max-age=31536000, immutable
/cards.css
  Cache-Control: public, max-age=31536000, immutable
/cards.js
  Cache-Control: public, max-age=31536000, immutable
/counter.css
  Cache-Control: public, max-age=31536000, immutable
/counter.js
  Cache-Control: public, max-age=31536000, immutable
/pdf-tools.css
  Cache-Control: public, max-age=31536000, immutable
/pdf-tools-2.css
  Cache-Control: public, max-age=31536000, immutable
/pdf-tools.js
  Cache-Control: public, max-age=31536000, immutable
/poster.css
  Cache-Control: public, max-age=31536000, immutable

# Icons rarely change
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/favicon.png
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# Service worker must always revalidate
/sw.js
  Cache-Control: no-cache

# SEO / agent files: served straight from the asset store (not the Worker) with explicit MIME types
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=2592000
